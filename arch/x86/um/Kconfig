menu "Host processor type and features"

source "arch/x86/Kconfig.cpu"

endmenu

config UML_X86
	def_bool y
	select ARCH_USE_QUEUED_RWLOCKS
	select ARCH_SUPPORTS_ATOMIC_RMW
	select ARCH_USE_QUEUED_SPINLOCKS
	select DCACHE_WORD_ACCESS
	select HAVE_EFFICIENT_UNALIGNED_ACCESS
	select HAVE_EBPF_JIT if 64BIT
	select ARCH_WANT_DEFAULT_BPF_JIT if 64BIT
	select HAVE_CMPXCHG_DOUBLE if 64BIT
	select HAVE_ALIGNED_STRUCT_PAGE if 64BIT
	select UML_SUBARCH_SUPPORTS_SMP if X86_CX8

# UML/x86 reuses arch/x86/kernel/uprobes.c via subarch-y; the guest-user
# int3/single-step relay arrives as SIGTRAP through the skas trap path.
config ARCH_SUPPORTS_UPROBES
	def_bool y
	depends on UML_X86 && 64BIT

config 64BIT
	bool "64-bit kernel" if "$(SUBARCH)" = "x86"
	default "$(SUBARCH)" != "i386"

config X86_32
	def_bool !64BIT
	select ARCH_32BIT_OFF_T
	select ARCH_WANT_IPC_PARSE_VERSION
	select MODULES_USE_ELF_REL
	select CLONE_BACKWARDS
	select OLD_SIGSUSPEND3
	select OLD_SIGACTION

config X86_64
	def_bool 64BIT
	select MODULES_USE_ELF_RELA

config ARCH_HAS_SC_SIGNALS
	def_bool !64BIT

config GENERIC_HWEIGHT
	def_bool y
