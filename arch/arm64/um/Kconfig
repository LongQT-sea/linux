menu "Host processor type and features (arm64)"
endmenu

config UML_ARM64
	def_bool y
	select CLONE_BACKWARDS
	# Loadable modules. aarch64 modules are RELA, and the relocation
	# processing is arch/arm64/kernel/module.c reused unchanged, the
	# same arrangement x86 UML has used for its own module.c for
	# years (subarch-$(CONFIG_MODULES) in the Makefile).
	# HAVE_MOD_ARCH_SPECIFIC goes with it because arm64's struct
	# mod_arch_specific carries the PLT bookkeeping module-plts.c
	# fills in.
	select MODULES_USE_ELF_RELA
	select HAVE_MOD_ARCH_SPECIFIC
	select UML_SUBARCH_MEMCPY

config GENERIC_HWEIGHT
	def_bool y

config GENERIC_CSUM
	def_bool y

config 64BIT
	def_bool y
