menu "Host processor type and features (s390)"
endmenu

config UML_S390
	def_bool y
	select UML_SUBARCH_MEMCPY
	select CLONE_BACKWARDS2
	select ARCH_WANT_IPC_PARSE_VERSION
	help
	  s390 passes clone(2) with the first two arguments swapped
	  (stack first, then flags — arch/Kconfig "ABI hall of shame").
	  The arm64 port needed plain CLONE_BACKWARDS (tls in 4th arg);
	  getting this wrong silently decodes the wrong stack/flags and
	  breaks threading. [DESIGN §8.5, P4: right first try]

config GENERIC_HWEIGHT
	def_bool y

config 64BIT
	def_bool y

config CPU_BIG_ENDIAN
	def_bool y
